# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]
*.pyo

# Environment variables / secrets
.env
.env.*
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/

# Frontend
frontend/node_modules/
frontend/.vite/
frontend/coverage/
.vite/
*.tsbuildinfo

# Stray root npm lockfile (the project has no root package.json)
/package-lock.json

# Local server logs
*.log

# Local runtime / databases
*.sqlite
*.sqlite3
*.db

# Local downloaded / generated knowledge data
data/
audit_sources/

# Local audit scratch output (per-session dumps, not part of the app)
audit_compare.json

# Terraform runtime artifacts (generated; never commit)
.terraform/
*.tfplan
terraform.tfstate*
terraform.tfvars

# Durable provisioning workspaces (var/terraform/<session>/<tree>/)
var/