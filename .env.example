# ============================================================
# AI Architect LLM
# ============================================================

# Supported:
#   ollama
#   opencode
# Switching provider requires no code change.
AI_ARCHITECT_LLM_PROVIDER=ollama

# Model used for every profile. A per-tier override below wins when set.
AI_ARCHITECT_OLLAMA_MODEL=gpt-oss:120b-cloud

# ============================================================
# Ollama
# ============================================================

# Native Ollama URL.
# Do NOT append /v1.
AI_ARCHITECT_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional per-profile overrides (fall back to the model above).
# Demo standard: leave these empty so every tier uses the Large model.
AI_ARCHITECT_OLLAMA_LOW_MODEL=
AI_ARCHITECT_OLLAMA_MEDIUM_MODEL=
AI_ARCHITECT_OLLAMA_HIGH_MODEL=

# ============================================================
# OpenCode Zen
# ============================================================

# Zen serves different models through different endpoint families
# (/chat/completions, /responses, /messages) under this base. The
# client resolves the right family from the configured model id and
# fails loudly if the model is unknown rather than guessing.
AI_ARCHITECT_OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Never put a real secret in this file.
AI_ARCHITECT_OPENCODE_API_KEY=

# Model used for every profile. A per-tier override below wins.
AI_ARCHITECT_OPENCODE_MODEL=

# Optional per-profile overrides (fall back to the model above).
AI_ARCHITECT_OPENCODE_LOW_MODEL=
AI_ARCHITECT_OPENCODE_MEDIUM_MODEL=
AI_ARCHITECT_OPENCODE_HIGH_MODEL=

# Optional explicit API style: chat_completions | responses | messages.
# Leave empty to resolve from the model id.
AI_ARCHITECT_OPENCODE_API_STYLE=

# ============================================================
# Reasoning effort
# ============================================================

# Logical, provider-independent effort:
#   default | low | medium | high | xhigh | max
# "default" uses the model's own default and sends nothing if the
# model declares none. The registry resolves this against the model's
# real capabilities: a level the model does not support is capped down
# and the cap is reported, never applied silently. Where a capability
# is not published, no effort parameter is sent at all, which leaves
# the model's own behaviour untouched.
#
# A profile selects the MODEL; effort selects reasoning DEPTH. They are
# independent, so nothing maps LOW->low automatically.
AI_ARCHITECT_LLM_EFFORT=default

# Optional per-profile effort override (falls back to the value above).
AI_ARCHITECT_LLM_EFFORT_LOW=
AI_ARCHITECT_LLM_EFFORT_MEDIUM=
AI_ARCHITECT_LLM_EFFORT_HIGH=

# ============================================================
# Architect defaults
# ============================================================

# Region the architect may apply when the user delegates a choice
# ("you decide") and no residency/compliance constraint applies.
# Recorded as an explicit architect_default assumption.
# Leave empty to keep region clarification blocking.
AI_ARCHITECT_DEFAULT_REGION=

# ============================================================
# Observability
# ============================================================

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-architect

# ============================================================
# Knowledge retrieval
# ============================================================

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=architecture_knowledge

EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================
# Local API safety (design API server)
# ============================================================

# Bearer token required by every mutating API endpoint (create
# session, run, messages, approve-design, terraform, approve-
# provisioning, provision). Read endpoints and /health stay open.
# When unset, mutating endpoints refuse with 503 (fail closed).
# Generate one locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never put a real deployment secret in this file.
AI_ARCHITECT_API_TOKEN=

# Optional: comma-separated browser origins allowed by CORS.
# Defaults to the local dev UI when unset:
#   http://localhost:5173,http://127.0.0.1:5173
# AI_ARCHITECT_CORS_ORIGINS=

# Optional: API bind address. Defaults are loopback-only
# (python -m ai_architect.api); change only deliberately.
# AI_ARCHITECT_API_HOST=127.0.0.1
# AI_ARCHITECT_API_PORT=8000
